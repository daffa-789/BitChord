# Salin berkas ini menjadi `keystore.properties` di akar repo, lalu isi nilainya.
# `keystore.properties` dan `*.jks` sudah diabaikan git (lihat .gitignore) — jangan
# pernah meng-commit kunci signingnya, dan jangan pernah membagikannya.
#
# Membuat keystore baru (hanya sekali, untuk umur aplikasi):
#
#   keytool -genkeypair -v \
#     -keystore bitchord-release.jks -storetype JKS -alias bitchord \
#     -keyalg RSA -keysize 4096 -validity 10950 \
#     -storepass <password> -keypass <password> \
#     -dname "CN=BitChord, OU=BitChord, O=BitChord Contributors, C=ID"
#
# Keystore ini adalah identitas aplikasi selamanya. APK yang sudah terinstall di
# perangkat orang hanya bisa diperbarui dengan kunci yang sama persis — kalau
# hilang, satu-satunya jalan adalah mengganti applicationId, dan itu berarti
# semua pengguna harus uninstall lalu memasang ulang.
#
# Untuk build lokal, taruh berkas .jks di akar repo lalu isi berkas ini.
# Untuk CI, repo memakai secret GitHub: KEYSTORE_BASE64 (isi berkas .jks
# di-base64), KEYSTORE_PASSWORD, KEY_ALIAS, dan KEY_PASSWORD. Lihat
# `.github/workflows/release.yml`, bagian "Setup Keystore if secret present".

storeFile=bitchord-release.jks
storePassword=
keyAlias=bitchord
keyPassword=
